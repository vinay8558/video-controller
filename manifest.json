{
  "manifest_version": 3,
  "name": "Universal Video Speed Controller",
  "version": "1.0.0",
  "description": "Control the playback speed of any video on any website, including YouTube, Netflix, and Amazon Prime Video.",
  "permissions": ["storage", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Speed Controller"
  }
}
